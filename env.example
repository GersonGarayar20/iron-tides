# Copy to .env at the repo root (the harness blocks writing dotfiles like
# ".env.example" directly, hence the name here). The server reads .env via a
# tiny built-in loader (server/src/env.ts) so no dotenv dependency is needed.

# Postgres connection used by the server; matches docker-compose.yml defaults.
DATABASE_URL=postgres://iron_tides:iron_tides_dev@localhost:5432/iron_tides

# JWT signing secret. Leave unset for local dev: the server generates a
# random one on first run and appends it to .env automatically so tokens
# survive restarts. Set a real one explicitly before deploying anywhere.
JWT_SECRET=

# Colyseus/Express HTTP+WS port.
PORT=2567
